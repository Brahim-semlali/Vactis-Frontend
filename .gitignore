# ============================================================
#  .gitignore — Frontend React/Parcel (stagelabo-front)
# ============================================================

# ── Dépendances ──────────────────────────────────────────────
node_modules/

# ── Build Parcel ─────────────────────────────────────────────
dist/
build/
.parcel-cache/
.cache/

# ── Secrets & configuration sensible ─────────────────────────
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Tests / couverture ───────────────────────────────────────
coverage/
.nyc_output/

# ── IDE — IntelliJ IDEA ──────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
out/

# ── IDE — VS Code ────────────────────────────────────────────
.vscode/
!.vscode/extensions.json

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Divers ───────────────────────────────────────────────────
*.swp
*.swo
*~
*.local
